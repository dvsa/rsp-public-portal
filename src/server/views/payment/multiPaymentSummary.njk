{% extends 'layouts/base.layout.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}

{% set pageTitle = t.site_title %}
{% set pageBreadcrumbItems = [
    { text: t.breadcrumbs.home, href: '/' },
    { text: t.breadcrumbs.payment_code, href: '/payment-code' },
    { text: t.breadcrumbs.penalty_details, href: '/payment-code/' + paymentCode },
    { text: t.breadcrumbs.payment }
  ]
%}

{% if penaltyType == 'FPN' %}
  {% set titleAndContinueButtonText = t.penalty_details_page.pay_fixed_penalties_text %}
{% elif penaltyType == 'CDN' %}
  {% set titleAndContinueButtonText = t.penalty_details_page.pay_court_deposits_text %}
{% elif penaltyType == 'IM' %}
  {% set titleAndContinueButtonText = t.penalty_details_page.pay_immobilisation_fee_text %}
{% endif %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form action="/payment-code/{{ paymentCode }}/{{ penaltyType }}/payment" method="post">
        <h1 class="govuk-heading-xl">{{ titleAndContinueButtonText }}</h1>
        {# Payment summary table #}
        <table class="govuk-table">
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th scope="col" class="govuk-table__header">{{ t.penalty_details.reference }}</th>
              <th scope="col" class="govuk-table__header govuk-table__header--numeric">{{ t.penalty_details.amount }}</th>
              <th scope="col" class="govuk-table__header">{{ t.penalty_details.status }}</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for penalty in penaltyDetails %}
              {% set statusClass = 'confirmed' if penalty.status == 'PAID' else 'unconfirmed' %}
              <tr class="govuk-table__row">
                <td class="govuk-table__cell">{{ penalty.formattedReference | escape }}</td>
                <td class="govuk-table__cell govuk-table__cell--numeric">&pound;{{ penalty.amount | escape }}</td>
                <td class="govuk-table__cell {{ statusClass }}">
                  <strong>
                    {{ t.penalty_details.status_paid if penalty.status == 'PAID' else t.penalty_details.status_unpaid }}
                  </strong>
                </td>
              </tr>
            {% endfor %}
            {% if penaltyDetails.length > 1 %}
              <tr class="govuk-table__row">
                <th scope="row" class="govuk-table__header">{{ t.penalty_details_page.amount_due }}</th>
                <td class="govuk-table__cell govuk-table__cell--numeric"><strong>&pound;{{ totalAmount if totalAmount else 'N/A' }}</strong></td>
                <td class="govuk-table__cell"></td>
              </tr>
            {% endif %}
          </tbody>
        </table>

        {% if paymentStatus != 'PAID' %}
          {{ govukInsetText({
            text: t.penalty_details_page.gdpr_notification
          }) }}
          {% if paymentPending %}
            {{ govukWarningText({
              text: t.payment_pending_page.pending_notice.replace('MINUTES', pendingMinutes),
              iconFallbackText: "Warning"
            }) }}
          {% endif %}
          {{ govukButton({
            text: titleAndContinueButtonText,
            type: "submit",
            disabled: paymentPending
          }) }}
          {% set assistanceHtml %}
            <p class="govuk-body">{{ t.penalty_details_page.call_dvsa }}</p>
            <p class="govuk-body">
              <a href="https://www.gov.uk/call-charges" target="_blank" rel="noopener noreferrer" class="govuk-link">
                {{ t.penalty_details_page.call_charges_link }}
              </a>
            </p>
            <p class="govuk-body">{{ t.penalty_details_page.info_needed }}</p>
          {% endset %}
          {{ govukDetails({
            summaryText: t.penalty_details_page.payment_assistance_panel_title,
            html: assistanceHtml
          }) }}
        {% endif %}
      </form>
    </div>
  </div>

{% endblock %}
