{% extends 'layouts/base.layout.njk' %}

{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/details/macro.njk" import govukDetails %}

{% set pageTitle = t.payment_code_page.title %}
{% set paymentCodeError = t.payment_code_page.overdue_error if type == 'overdue' else t.payment_code_page.error %}
{% set pageBreadcrumbItems = [
    { text: t.breadcrumbs.home, href: '/' },
    { text: t.breadcrumbs.payment_code }
] %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if invalidPaymentCode %}
        {{ govukErrorSummary({
          titleText: paymentCodeError.title,
          errorList: [
            {
              text: paymentCodeError.invalid_code,
              href: "#payment_code"
            }
          ]
        }) }}
        <p class="govuk-body">{{ paymentCodeError.description }}</p>
      {% endif %}

      <h1 class="govuk-heading-xl">{{ t.payment_code_page.title }}</h1>

      <form method="post" action="/payment-code" novalidate>

        {{ govukInput({
          id: "payment_code",
          name: "payment_code",
          label: {
            text: t.payment_code_page.payment_code
          },
          hint: {
            text: t.payment_code_page.hint
          },
          errorMessage: {
            text: paymentCodeError.invalid_code
          } if invalidPaymentCode,
          attributes: {
            maxlength: 19
          }
        }) }}

        {% if type == 'overdue' %}
          {% if id %}
            <p class="govuk-body">
              <strong>{{ t.payment_code_page.overdue_error.payment_code_colon }}</strong>
              {{ id | escape }}
            </p>
          {% endif %}
          <p class="govuk-body">{{ t.payment_code_page.overdue_error.assistance_intro }}</p>
          <p class="govuk-body">{{ t.payment_code_page.overdue_error.assistance_instructions }}</p>
          <p class="govuk-body">{{ t.payment_code_page.overdue_error.contact }}</p>
          <div class="govuk-inset-text">
            <h2 class="govuk-heading-m">{{ t.payment_code_page.contact_title }}</h2>
            <ul class="govuk-list">
              <li>
                <a href="mailto:{{ t.payment_code_page.contact_email }}" class="govuk-link">{{ t.payment_code_page.contact_email }}</a>
              </li>
              <li>{{ t.payment_code_page.contact_phone }}</li>
              <li>{{ t.payment_code_page.contact_opening_hours }}</li>
              <li>
                <a href="https://www.gov.uk/call-charges" class="govuk-link">{{ t.payment_code_page.call_charges_link }}</a>
              </li>
            </ul>
          </div>
        {% else %}
          {{ govukDetails({
            summaryText: t.payment_code_page.hidden_panel_title,
            html: '<p>' + t.penalty_details_page.details_assistance_panel_paragraph_1 + '</p>
                   <ul class="govuk-list govuk-list--bullet">
                     <li>' + t.penalty_details_page.tell_examiner + '</li>
                     <li>' + t.penalty_details_page.call_dvsa + '</li>
                   </ul>'
          }) }}
        {% endif %}

        {{ govukButton({
          text: t.payment_code_page.continue_button
        }) }}
      </form>

    </div>
  </div>
{% endblock %}
